<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Content Mock (Below Top Panel) -->
    <LinearLayout
        android:id="@+id/shimmer_content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/shimmer_bottom_nav"
        app:layout_constraintTop_toTopOf="parent">

        <!-- "Live Updates" Title Placeholder -->
        <View
            android:layout_width="120dp"
            android:layout_height="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/grey_rect"
            android:alpha="0.3" />

        <include layout="@layout/item_match_shimmer" />
        <include layout="@layout/item_match_shimmer" />
        <include layout="@layout/item_match_shimmer" />
    </LinearLayout>

    <!-- Bottom Nav Mock -->
    <include
        android:id="@+id/shimmer_bottom_nav"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="12dp"
        layout="@layout/shimmer_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
