<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Cricket.CardView"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_marginBottom="20dp"
    app:strokeColor="#33FF5C00"
    app:strokeWidth="1.5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/img_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            tools:src="@tools:sample/backgrounds/scenic" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_trending_card" />

        <!-- Top Badges -->
        <TextView
            android:id="@+id/text_tournament_name"
            android:fontFamily="@font/jet_brains_mono_regular"
            android:textSize="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_badge_overlay"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="ICC T20 WORLD CUP" />

        <LinearLayout
            android:id="@+id/text_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="23dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_badge_live_red"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/dot_live_tournament"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/live_dot"
                android:backgroundTint="@color/white" />

            <TextView
                android:id="@+id/text_live_badge_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jet_brains_mono_bold"
                android:text="LIVE"
                android:textColor="@color/white"
                android:textSize="12dp" />

        </LinearLayout>

        <!-- Center Match Title -->
        <TextView
            android:id="@+id/text_match_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:fontFamily="@font/oswald_regular"
            android:textSize="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="AUSTRALIA VS INDIA" />

        <!-- Bottom Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_action"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/text_status_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="14dp"
                android:fontFamily="@font/jet_brains_mono_semi_bold"
                tools:text="LIVE NOW" />

            <TextView
                android:id="@+id/text_status_sub"
                android:fontFamily="@font/jet_brains_mono_semi_bold"
                android:textSize="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:textColor="@color/white"
                tools:text="1.2M WATCHING" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"
            android:background="@drawable/rounded_rect_bck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:minHeight="44dp"
            android:fontFamily="@font/oswald_regular"
            android:textSize="15dp"
            android:paddingHorizontal="24dp"
            android:text="WATCH NOW"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_starting_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="2dp"
            android:fontFamily="@font/jet_brains_mono_regular"
            android:text="Starting in"
            android:textColor="@color/white"
            android:alpha="0.7"
            android:textSize="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/text_countdown"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/jet_brains_mono_bold"
            android:textColor="@color/primary"
            android:textSize="14dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="02:15:30"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
