<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_privacy"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_gradient_header"
        android:theme="@style/ThemeOverlay.FootballApp.Toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@color/text_on_primary" />

    <ProgressBar
        android:id="@+id/progress_privacy"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progressTint="@color/accent_cyan"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_privacy" />

    <WebView
        android:id="@+id/webview_privacy"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_privacy" />

</androidx.constraintlayout.widget.ConstraintLayout>
