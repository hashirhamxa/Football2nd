<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh_highlights"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fragment_bottom_padding">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <!-- Multi-Section Layout (Default) -->
        <LinearLayout
            android:id="@+id/layout_multi_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cricket Section -->
            <RelativeLayout
                android:id="@+id/section_cricket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp">

                <ImageView
                    android:id="@+id/indicator_cricket"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/cricket_tittle_icon"
                    />

                <TextView
                    android:id="@+id/text_cricket_header"
                    style="@style/SectionTitleStyle"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/indicator_cricket"
                    android:layout_centerVertical="true"
                    android:text="Highlights"
                    android:textStyle="bold|italic" />

                <TextView
                    android:id="@+id/btn_see_all_cricket"
                    style="@style/AllActionStyle"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="ALL >" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_cricket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_match" />

            <!-- Football Section -->
            <RelativeLayout
                android:id="@+id/section_football"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/indicator_football"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/football_tittle_icon"
                    />

                <TextView
                    android:id="@+id/text_football_header"
                    style="@style/SectionTitleStyle"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/indicator_football"
                    android:layout_centerVertical="true"
                    android:text="Highlights"
                    android:textStyle="bold|italic"  />

                <TextView
                    android:id="@+id/btn_see_all_football"
                    style="@style/AllActionStyle"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="ALL >"/>
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_football"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_match" />

            <!-- Trending Section -->
            <RelativeLayout
                android:id="@+id/section_trending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"            >

                <ImageView
                    android:id="@+id/indicator_trending"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/trending_tittle_icon"
                    />

                <TextView
                    android:id="@+id/text_trending_header"
                    style="@style/SectionTitleStyle"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/indicator_trending"
                    android:layout_centerVertical="true"
                    android:text="Highlights"
                    android:textStyle="bold|italic"/>

                <TextView
                    android:id="@+id/btn_see_all_trending"
                    style="@style/AllActionStyle"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="ALL >"/>
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_trending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_trending" />

        </LinearLayout>

        <!-- Single Section Layout -->
        <LinearLayout
            android:id="@+id/layout_single_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"              >

                <ImageView
                    android:id="@+id/indicator_single"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/trending_tittle_icon" />

                <TextView
                    android:id="@+id/text_single_title"
                    style="@style/SectionTitleStyle"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/indicator_single"
                    android:layout_centerVertical="true"
                    android:text="Highlights"
                    android:textStyle="bold|italic"/>
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_single"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_match" />
        </LinearLayout>

    </FrameLayout>

</androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
