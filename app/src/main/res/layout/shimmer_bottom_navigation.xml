<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Cricket.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/nav_card_margin"
    app:cardCornerRadius="@dimen/card_corner_radius_large"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Item 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <View
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:alpha="0.3"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/surface_variant" />
            <View
                android:layout_width="34dp"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:alpha="0.2"
                android:background="@drawable/grey_rect" />
        </LinearLayout>

        <!-- Item 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <View
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:alpha="0.3"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/surface_variant" />
            <View
                android:layout_width="34dp"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:alpha="0.2"
                android:background="@drawable/grey_rect" />
        </LinearLayout>

        <!-- Item 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <View
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:alpha="0.3"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/surface_variant" />
            <View
                android:layout_width="34dp"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:alpha="0.2"
                android:background="@drawable/grey_rect" />
        </LinearLayout>

        <!-- Item 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <View
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:alpha="0.3"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/surface_variant" />
            <View
                android:layout_width="34dp"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:alpha="0.2"
                android:background="@drawable/grey_rect" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
