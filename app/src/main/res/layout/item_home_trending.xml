<?xml version="1.0" encoding="utf-8"?>

<livefootball.footballstreamning.fifaworldcup.utilities.ParallelogramCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trending_card"
    android:layout_width="280dp"
    android:layout_height="160dp"
    android:layout_margin="8dp"
    app:skewAmount="18dp"
    app:cardCornerRadius="0dp"
    app:cardStrokeColor="@color/primary"
    app:cardStrokeWidth="1.5dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/img_trending_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds/scenic" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gradient_overlay" />

        <FrameLayout
            android:id="@+id/layout_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="24dp"
                android:scaleType="fitXY"
                android:src="@drawable/bg_live_badge_angled" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/dot_live_trending"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ic_dot_green" />

                <TextView
                    android:id="@+id/badge_live_trending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:fontFamily="@font/jet_brains_mono_bold"
                    android:textColor="@color/black"
                    android:textSize="11dp"/>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/text_trending_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="@font/inter_regular"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="SUPER 8 STAGE" />

        <FrameLayout
            android:id="@+id/ribbon_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@id/text_trending_title"
            app:layout_constraintStart_toStartOf="parent">

            <!--
                No ImageView here anymore. text_category's background is
                set at bind time to a ParallelogramRibbonDrawable, which
                sizes itself to the TextView's actual measured bounds.
            -->
            <TextView
                android:id="@+id/text_category"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="60dp"
                android:background="@drawable/bg_tournament_tag_ribbon"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/black"
                android:textSize="12dp"
                android:fontFamily="@font/jet_brains_mono_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                tools:text="T20 WORLD CUP" />
        </FrameLayout>

        <!-- Countdown for upcoming events -->
        <TextView
            android:id="@+id/text_starting_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="2dp"
            android:fontFamily="@font/jet_brains_mono_regular"
            android:text="Starting in"
            android:textColor="@color/white"
            android:alpha="0.7"
            android:textSize="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/text_countdown"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/jet_brains_mono_bold"
            android:textColor="@color/primary"
            android:textSize="14dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="02:15:30"
            tools:visibility="visible" />

        <!-- Existing hidden views for ID compatibility -->
        <View android:id="@+id/bg_live_overlay" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_watch_now" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/text_trending_desc" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <View android:id="@+id/btn_details" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</livefootball.footballstreamning.fifaworldcup.utilities.ParallelogramCardView>