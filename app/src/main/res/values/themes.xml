<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FootballApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_dark_green</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorSecondaryVariant">@color/primary_dark_green</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- UI and Background -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error_red</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary_dark_green</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.FootballApp" parent="Base.Theme.FootballApp" />

    <!-- Detail Screen Toolbar Style -->
    <style name="ThemeOverlay.FootballApp.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>
</resources>
