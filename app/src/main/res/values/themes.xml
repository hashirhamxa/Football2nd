<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Base.Theme.Cricket" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/black</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/white</item>

        <!-- Global Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Cricket.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Cricket.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Cricket.HeadlineSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Cricket.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Cricket.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Cricket.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Cricket.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Cricket.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Cricket.LabelSmall</item>

        <!-- Status and Navigation Bars -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Cricket" parent="Base.Theme.Cricket" />

    <style name="Theme.Cricket.Splash" parent="Theme.Cricket">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.Cricket.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/archivo_narrow_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/text_size_headline_large</item>
    </style>
    <style name="TextAppearance.Cricket.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/archivo_narrow_medium</item>
        <item name="android:textSize">@dimen/text_size_headline_medium</item>
    </style>
    <style name="TextAppearance.Cricket.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/archivo_narrow_reg</item>
        <item name="android:textSize">@dimen/text_size_headline_small</item>
    </style>

    <style name="TextAppearance.Cricket.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
    </style>
    <style name="TextAppearance.Cricket.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">@dimen/text_size_body_medium</item>
    </style>
    <style name="TextAppearance.Cricket.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter_light</item>
        <item name="android:textSize">@dimen/text_size_body_small</item>
    </style>

    <style name="TextAppearance.Cricket.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/jet_brains_mono_bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
    </style>
    <style name="TextAppearance.Cricket.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/jet_brains_mono_bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
    </style>
    <style name="TextAppearance.Cricket.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/jet_brains_mono_regular</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
    </style>

    <style name="TextAppearance.Cricket.Score" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/jet_brains_mono_bold</item>
        <item name="android:textSize">@dimen/text_size_score</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.Cricket.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/jet_brains_mono_bold</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Cricket.Button</item>
    </style>

    <style name="ShapeAppearance.Cricket.Button" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Cricket.Button.Small" parent="ShapeAppearance.Cricket.Button">
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.Cricket.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="strokeColor">@color/surface_variant</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- Specific Components -->
    <style name="BadgeStyle">
        <item name="android:paddingStart">@dimen/spacing_small</item>
        <item name="android:paddingEnd">@dimen/spacing_small</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:fontFamily">@font/jet_brains_mono_bold</item>
        <item name="android:background">@drawable/bg_badge_live</item>
    </style>

    <style name="Widget.Cricket.ActiveIndicator" parent="">
        <item name="android:color">@color/active_indicator</item>
        <item name="android:width">@dimen/nav_indicator_width</item>
        <item name="android:height">@dimen/nav_indicator_height</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Cricket.ActiveIndicator</item>
    </style>

    <style name="ShapeAppearance.Cricket.ActiveIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/nav_indicator_corner_radius</item>
    </style>

    <style name="Widget.Cricket.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/TextAppearance.Cricket.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Cricket.LabelMedium</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Cricket.ActiveIndicator</item>
        <item name="itemRippleColor">@color/active_indicator</item>
        <item name="android:background">@android:color/transparent</item>
    </style>


    <style name="BaseTheme.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/ui_controls_background</item>
        <item name="android:navigationBarColor">@color/ui_controls_background</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:ignore="NewApi">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
    <style name="Theme.Player" parent="BaseTheme.Player">
    </style>
</resources>
